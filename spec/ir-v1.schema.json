{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://PabloGonzalezRuiz.github.io/xmind-md-ts/schema/ir-v1.schema.json",
  "title": "XMind MD TS Intermediate Representation v1",
  "description": "Canonical, target-neutral IR for one Markdown source document and one mind-map sheet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "irVersion",
    "document",
    "sheet"
  ],
  "properties": {
    "irVersion": {
      "const": "1.0.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "sheet": {
      "$ref": "#/$defs/sheet"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "default": []
    },
    "styleSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleSet"
      },
      "default": []
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\\\s]+$"
    },
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rootTopic"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "rootTopic": {
          "$ref": "#/$defs/topic"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "default": []
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary"
          },
          "default": []
        },
        "summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          },
          "default": []
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          },
          "default": []
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          },
          "default": []
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hyperlink": {
          "type": "string",
          "format": "uri-reference"
        },
        "style": {
          "$ref": "#/$defs/styleReference"
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "contentBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/quote"
        },
        {
          "$ref": "#/$defs/imageBlock"
        },
        {
          "$ref": "#/$defs/thematicBreak"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "runs"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textRun"
          },
          "minItems": 1
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "enum": [
              "strong",
              "emphasis",
              "strike",
              "inlineCode"
            ]
          }
        },
        "link": {
          "type": "string",
          "format": "uri-reference"
        },
        "style": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ordered",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "ordered": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          },
          "minItems": 1
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          },
          "minItems": 1
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "alignments": {
          "type": "array",
          "items": {
            "enum": [
              "left",
              "center",
              "right",
              null
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableRow"
          },
          "minItems": 1
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCell"
          },
          "minItems": 1
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "language": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "blocks"
      ],
      "properties": {
        "type": {
          "const": "quote"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          },
          "minItems": 1
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "assetId",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "alt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "thematicBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "thematicBreak"
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceTopicId",
        "targetTopicId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceTopicId": {
          "$ref": "#/$defs/id"
        },
        "targetTopicId": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/styleReference"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "sourcePosition": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topicIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/styleReference"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topicIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/styleReference"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "styleReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string"
        },
        "styleId": {
          "$ref": "#/$defs/id"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "styleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "extends": {
          "$ref": "#/$defs/id"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/jsonValue"
        }
      }
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
