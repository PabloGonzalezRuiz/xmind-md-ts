{
  "name": "xmind-md-ts",
  "version": "0.1.0",
  "private": true,
  "description": "CLI para convertir Markdown enriquecido en mapas mentales XMind, JSON y SVG.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"spec/**/*.ts\" \"vitest.config.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"spec/**/*.ts\" \"vitest.config.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "lint": "eslint .",
    "start": "node dist/src/cli/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run format:check && npm run check:version && npm run lint && npm run check:generated-types && npm run typecheck && npm test && npm run build && npm run verify:examples && npm run verify:package",
    "generate:types": "node scripts/generate-ir-types.js",
    "check:generated-types": "node scripts/generate-ir-types.js --check",
    "verify:examples": "node scripts/verify-examples.js",
    "verify:package": "node scripts/verify-package.js",
    "check:version": "node scripts/check-package-version.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "remark-directive": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "ajv2020": "npm:ajv@8.20.0",
    "ajv-formats": "3.0.1",
    "xmind": "2.2.33"
  },
  "bin": {
    "xmind-md": "./bin/xmind-md.js"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/adapters.md",
    "docs/architecture.md",
    "docs/aud-009-xmind-desktop-validation.md",
    "docs/cli.md",
    "docs/decisions/ADR-0001-xmind-sdk.md",
    "docs/grammar.md",
    "docs/ir-specification.md",
    "docs/quality-and-testing.md",
    "docs/schema-validation.md",
    "docs/style-system.md",
    "docs/user-guide.md",
    "docs/versioning-and-compatibility.md",
    "examples/",
    "spec/ir-v1.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "exports": {},
  "prepack": "node scripts/create-build-manifest.js"
}
